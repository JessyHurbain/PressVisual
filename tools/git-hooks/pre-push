#!/usr/bin/env bash
# Crochet Git « pre-push » : vérifie la révision poussée, pas l'arbre de travail.
#
# Git annonce sur l'entrée standard les références qu'il s'apprête à envoyer ;
# le crochet en extrait les commits, en fait une copie de travail jetable
# (git worktree) et y rejoue tools/check_ci.sh. Vérifier l'arbre local ne dirait
# rien d'une branche qui n'est pas extraite, ni d'un commit entouré de
# modifications en cours : c'est la révision annoncée qui doit passer.
#
# Il rappelle ce que la poussée envoie, puis distingue la pointe de chaque
# référence — seule testée — des révisions antérieures qu'elle contient. Celles-
# ci ne sont pas testées séparément : leurs changements, eux, sont bien présents
# dans la révision testée, mais rien ne dit que chacune passait les tests à son
# époque. C'est déjà ce que fait la CI, qui ne teste que le commit poussé.
#
# La procédure appliquée est celle du dépôt courant (tools/check_ci.sh), sur les
# sources de la révision vérifiée — une révision antérieure à ce script est donc
# vérifiée elle aussi.
#
# Il est versionné avec les outils et activé par :
#   git config --local core.hooksPath tools/git-hooks
#
# Pour pousser sans attendre : git push --no-verify

set -euo pipefail

# En intégration continue, le workflow Tests joue déjà ces étapes sur le commit
# poussé : les refaire ici ne prouverait rien de plus.
if [[ -n ${CI:-}${GITHUB_ACTIONS:-} ]]; then
    exit 0
fi

CLONE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)

#: Révisions détaillées par référence avant un « … et N autres ».
LIST_MAX=5

note() { printf '[crochet] %s\n' "$1"; }

# « b3d88b25 Vérifier la révision poussée » : de quoi reconnaître un commit.
describe() {
    git -C "$CLONE_DIR" log -1 --format='%h %s' "$1"
}

# ---------------------------------------------------------------------------
# Interpréteur
# ---------------------------------------------------------------------------

# La copie de travail ne contient pas d'environnement virtuel : c'est celui du
# dépôt qui exécute les tests, sur les sources de la révision vérifiée.
PYTHON_VAR=()
if [[ -x $CLONE_DIR/.venv/bin/python ]]; then
    PYTHON_VAR=("PYTHON=$CLONE_DIR/.venv/bin/python")
elif [[ -x $CLONE_DIR/.venv/Scripts/python.exe ]]; then
    PYTHON_VAR=("PYTHON=$CLONE_DIR/.venv/Scripts/python.exe")
fi

# ---------------------------------------------------------------------------
# Références annoncées par Git
# ---------------------------------------------------------------------------

# Lancé à la main, le crochet n'a pas d'entrée à lire : on vérifie HEAD, et on
# compare à sa branche amont pour que le rapport reste juste.
if [[ -t 0 ]]; then
    note "appel manuel : vérification de HEAD."
    upstream=$(git -C "$CLONE_DIR" rev-parse -q --verify '@{upstream}' || true)
    input=$(printf 'HEAD %s HEAD %s\n' \
        "$(git -C "$CLONE_DIR" rev-parse HEAD)" "${upstream:-}")
else
    input=$(cat)
fi

# Une ligne par référence : <réf locale> <sha locale> <réf distante> <sha distante>.
REFS=()
TIPS=()
OLDS=()
while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ -z ${local_sha:-} ]]; then
        continue
    fi
    # Une suppression n'a aucun objet à vérifier ; Git la présente sous le nom
    # « (delete) » du côté local, la référence distante étant la seule utile.
    if [[ $local_sha =~ ^0+$ ]]; then
        note "${remote_ref:-$local_ref} : suppression, rien à vérifier."
        continue
    fi
    # Une étiquette annotée désigne un objet d'étiquette : on remonte au commit.
    commit=$(git -C "$CLONE_DIR" rev-parse -q --verify "$local_sha^{commit}") || continue
    REFS+=("$local_ref")
    TIPS+=("$commit")
    OLDS+=("${remote_sha:-}")
done <<<"$input"

# ---------------------------------------------------------------------------
# Ce que la poussée envoie, et ce qui sera testé
# ---------------------------------------------------------------------------

#: Révisions à tester : les pointes annoncées, dédoublonnées (une branche et son
#: étiquette peuvent désigner le même commit).
VERIFIED=()

if ((${#TIPS[@]})); then
    for index in "${!TIPS[@]}"; do
        ref=${REFS[$index]}
        tip=${TIPS[$index]}
        old=${OLDS[$index]}

        # Révisions que Git enverra pour cette référence : celles qui manquent au
        # distant, ou tout ce qui est atteignable si le distant ne les a pas.
        if [[ -n $old ]] && git -C "$CLONE_DIR" cat-file -e "${old}^{commit}" 2>/dev/null; then
            sent=$(git -C "$CLONE_DIR" rev-list "$old..$tip")
        else
            sent=$(git -C "$CLONE_DIR" rev-list "$tip")
        fi
        count=$(printf '%s\n' "$sent" | grep -c . || true)

        note "$ref — nouvelles révisions pour le distant : $count"
        note "  testée : $(describe "$tip")"

        if ((count > 1)); then
            included=$(printf '%s\n' "$sent" | grep -v -F -x "$tip")
            note "  non testées séparément : $((count - 1))"
            printed=0
            while read -r sha; do
                if [[ -z $sha ]]; then
                    continue
                fi
                if ((printed >= LIST_MAX)); then
                    note "    … et $((count - 1 - printed)) autre(s)"
                    break
                fi
                note "    $(describe "$sha")"
                printed=$((printed + 1))
            done <<<"$included"
            note "  (leurs changements sont inclus dans la révision testée)"
        fi

        duplicate=0
        if ((${#VERIFIED[@]})); then
            for known in "${VERIFIED[@]}"; do
                if [[ $known == "$tip" ]]; then
                    duplicate=1
                fi
            done
        fi
        if ((duplicate == 0)); then
            VERIFIED+=("$tip")
        fi
    done
fi

if ((${#VERIFIED[@]} == 0)); then
    note "rien à vérifier : aucune révision n'est envoyée."
    exit 0
fi

# ---------------------------------------------------------------------------
# Vérification, révision par révision
# ---------------------------------------------------------------------------

WORKTREE=""

cleanup() {
    if [[ -n $WORKTREE ]]; then
        git -C "$CLONE_DIR" worktree remove --force "$WORKTREE" 2>/dev/null || true
        rm -rf "$WORKTREE"
        git -C "$CLONE_DIR" worktree prune 2>/dev/null || true
        WORKTREE=""
    fi
}
trap cleanup EXIT

for revision in "${VERIFIED[@]}"; do
    # Une seule révision la plupart du temps : le rapport ci-dessus suffit.
    if ((${#VERIFIED[@]} > 1)); then
        note "vérification de ${revision:0:8}"
    fi

    WORKTREE=$(mktemp -d "${TMPDIR:-/tmp}/pressvisual-check-XXXXXX")
    if ! git -C "$CLONE_DIR" worktree add --detach --quiet "$WORKTREE" "$revision"; then
        note "impossible d'extraire cette révision : poussée interrompue."
        exit 1
    fi

    status=0
    if ((${#PYTHON_VAR[@]})); then
        ROOT_DIR="$WORKTREE" env "${PYTHON_VAR[@]}" \
            bash "$CLONE_DIR/tools/check_ci.sh" || status=$?
    else
        ROOT_DIR="$WORKTREE" bash "$CLONE_DIR/tools/check_ci.sh" || status=$?
    fi

    cleanup

    if ((status != 0)); then
        note "la vérification a échoué : poussée interrompue."
        note "corriger, puis réessayer — ou forcer : git push --no-verify"
        exit 1
    fi
done

exit 0
